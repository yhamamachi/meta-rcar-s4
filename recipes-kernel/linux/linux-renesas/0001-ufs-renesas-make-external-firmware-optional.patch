diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 87578e8..d2227c7 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -8981,6 +8981,13 @@ static int ufshcd_device_init(struct ufs_hba *hba, bool init_dev_params)
 	hba->ufshcd_state = UFSHCD_STATE_RESET;
 
 	ret = ufshcd_link_startup(hba);
+	/* Same retry as in ufshcd_init(). */
+	for (int tries = 0; ret && tries < 6; tries++) {
+		dev_warn(hba->dev, "link startup failed (%d), retrying\n", ret);
+		usleep_range(200000, 250000);
+		hba->ufshcd_state = UFSHCD_STATE_RESET;
+		ret = ufshcd_link_startup(hba);
+	}
 	if (ret)
 		return ret;
 
@@ -10852,6 +10859,18 @@ int ufshcd_init(struct ufs_hba *hba, void __iomem *mmio_base, unsigned int irq)
 	hba->ufshcd_state = UFSHCD_STATE_RESET;
 
 	err = ufshcd_link_startup(hba);
+	/*
+	 * With the bootloader-initialized PHY (no external firmware) the
+	 * first DME link startup can still miss the handshake. ufshcd_state
+	 * is re-set on every entry and no resources are re-requested, so
+	 * retrying here is safe.
+	 */
+	for (int tries = 0; err && tries < 6; tries++) {
+		dev_warn(hba->dev, "link startup failed (%d), retrying\n", err);
+		usleep_range(200000, 250000);
+		hba->ufshcd_state = UFSHCD_STATE_RESET;
+		err = ufshcd_link_startup(hba);
+	}
 	if (err)
 		goto out_disable;
 
diff --git a/drivers/ufs/host/Kconfig b/drivers/ufs/host/Kconfig
index 48ee7e9..640b11d 100644
--- a/drivers/ufs/host/Kconfig
+++ b/drivers/ufs/host/Kconfig
@@ -107,6 +107,23 @@ config SCSI_UFS_RENESAS
 
 	  If unsure, say N.
 
+config SCSI_UFS_RENESAS_FIRMWARE
+	bool "Load external initialization firmware for Renesas UFS host"
+	depends on SCSI_UFS_RENESAS
+	default n
+	help
+	  Enable to load r8a779f0_ufs.bin from the filesystem and use it for
+	  PHY initialization on R-Car S4 (requires calibration data from an
+	  nvmem "calibration" cell).
+
+	  Disable (default) to skip kernel-side PHY init and rely on the link
+	  the bootloader (U-Boot UFS scan) already brought up, so the kernel
+	  works without any external firmware dependency. The controller
+	  reset in ufshcd_hba_enable() does not clear the PHY registers, so
+	  link startup renegotiates from the bootloader PHY setup.
+
+	  If unsure, say N.
+
 config SCSI_UFS_TI_J721E
 	tristate "TI glue layer for Cadence UFS Controller"
 	depends on OF && HAS_IOMEM && (ARCH_K3 || COMPILE_TEST)
